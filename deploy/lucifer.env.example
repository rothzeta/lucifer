# Lucifer service configuration. Install as /etc/lucifer/lucifer.env,
# owner root, group lucifer, mode 0640. Plain KEY=value lines, no quotes.
# Never commit the real file: it holds the Navidrome password.

NAVIDROME_URL=http://navidrome.local:4533
NAVIDROME_USER=lucifer
NAVIDROME_PASSWORD=change-me

# Must be identical for the service and every maintenance run (reader lock).
LUCIFER_IPC_DIR=/run/lucifer
LUCIFER_CATALOGUE_PATH=/var/lib/lucifer/catalogue.json

# Stable serial path (see the udev example); fallback is /dev/ttyUSB0.
LUCIFER_NFC_DEVICE=/dev/ttyUSB0
# ALSA identifier of the DAC as mpv lists it: mpv --audio-device=help
# UNVERIFIED-ON-DEVICE: the default below is only the repository default.
LUCIFER_AUDIO_DEVICE=alsa/default:CARD=Pro
LUCIFER_MPV_PATH=mpv

# Transport controls (off unless both device and map are set). Discover the
# device and key codes on the Pi with:  Amp.Nfc input inspect --device <path>
# UNVERIFIED-ON-DEVICE: no key code or device path is verified for any controller.
# Prefer a stable /dev/input/by-id/... path over eventN.
#LUCIFER_INPUT_DEVICE=/dev/input/by-id/REPLACE-ME-event-kbd
#LUCIFER_INPUT_MAP=/var/lib/lucifer/input-map.json
# true makes a missing or lost input device fatal (exit 1, systemd restarts).
#LUCIFER_INPUT_REQUIRED=false
# Contact-bounce window per key, 0 to 5000.
#LUCIFER_INPUT_DEBOUNCE_MS=250

# Optional (defaults in README). Keep below the unit's TimeoutStopSec.
#LUCIFER_SHUTDOWN_TIMEOUT_SECONDS=10
#LUCIFER_MPV_START_TIMEOUT_SECONDS=5
#LUCIFER_HTTP_TIMEOUT_SECONDS=15
#LUCIFER_READER_TIMEOUT_SECONDS=30
#LUCIFER_ABSENCE_CONFIRM_MS=1500

# Only if the Pi lacks ICU libraries and the app fails to start:
#DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
